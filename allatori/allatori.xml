<config>

    <property name="control-flow-obfuscation" value="enable"/>
    <property name="extensive-flow-obfuscation" value="maximum"/>
    <property name="string-encryption" value="enable"/>

    <input>
        <jar in="AutoShulker-${project.version}.jar" out="AutoShulker-${project.version}.jar"/>
    </input>

    <classpath>
        <jar name="${settings.localRepository}\org\spigotmc\spigot-api\1.18.2-R0.1-SNAPSHOT\spigot-api-1.18.2-R0.1-SNAPSHOT.jar" />
    </classpath>

    <keep-names>
        <!--<class access="public" />-->
        <!--<method access="public" />-->
        <!--<field access="public" />-->
        <class template="class de.jeff_media.autoshulker.Main" />
        <method template="getHandlerList()" />
        <class template="class **API**">
            <method template="public *(**)" />
        </class>
        <method template="@java.lang.Override *(**)" />
        <class template="class **.bstats.**" />
        <class template="class **.Metrics.**" />
        <class template="class **.jefflib.**"/>
        <class template="class ** extends org.bukkit.configuration.serialization.ConfigurationSerializable">
            <method template="public *(**)"/>
        </class>
    </keep-names>

    <property name="log-file" value="log.xml"/>

    <property name="generics" value="remove"/>
    <property name="line-numbers" value="obfuscate"/> <!-- For Debugging: keep -->
    <property name="inner-classes" value="remove"/>
    <property name="default-package" value="de.jeff_media.autoshulker"/>
    <property name="force-default-package" value="enable"/>
    <property name="synthetize-methods" value="disable"/>
    <property name="synthetize-fields" value="disable"/>
    <property name="remove-toString" value="enable"/>
    <property name="string-encryption-type" value="strong"/>
    <property name="string-encryption-version" value="v4" add="de.jeff_media.autoshulker.Main"/>
    <property name="string-encryption-ignored-strings" value="../allatori/spigotmc-patterns.txt"/>
    <ignore-classes>
        <class template="class **.co.aikar.**" />
        <class template="class **.nms.**" />
        <class template="class **NMS**"/>
    </ignore-classes>
</config>
